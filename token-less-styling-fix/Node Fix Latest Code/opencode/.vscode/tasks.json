    {
      "label": "Team: check agents loaded",
      "type": "shell",
      "command": "opencode agent list",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Team: apply models.json",
      "type": "shell",
      "command": "node tools/set-models.mjs",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
