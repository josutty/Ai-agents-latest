{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "node .cursor/hooks/scaffold-from-command.mjs",
        "failClosed": false
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/verify-artifacts.mjs",
        "failClosed": true,
        "matcher": "git commit|git push"
      }
    ]
  }
}
